 */

/* ---------- tokens ---------- */
:root {
  --ink: #ece7dd;
  --ink-soft: #b8b2a6;
  --paper: #121214;
  --paper-2: #1a1a1e;
  --card: #1f1f24;
  --line: #2c2c33;
