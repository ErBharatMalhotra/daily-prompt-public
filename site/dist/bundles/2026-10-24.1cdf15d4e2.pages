  --shadow-soft: 0 4px 14px rgba(0, 0, 0, .25);
  --nav-bg: rgba(18, 18, 20, .62);
}
[data-theme="light"] {
  --ink: #191919;
  --ink-soft: #5c5952;
  --paper: #f7f3ea;
  --paper-2: #efe9db;
  --card: #ffffff;
  --line: #e3dcc9;
