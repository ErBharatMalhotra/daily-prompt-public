  --shadow: 0 10px 30px rgba(0, 0, 0, .35);
  --shadow-soft: 0 4px 14px rgba(0, 0, 0, .25);
  --nav-bg: rgba(18, 18, 20, .62);
}
[data-theme="light"] {
  --ink: #191919;
  --ink-soft: #5c5952;
  --paper: #f7f3ea;
  --paper-2: #efe9db;
  --card: #ffffff;
  --line: #e3dcc9;
  --accent: #a31212;
  --accent-deep: #8b0000;
  --ok-bg: #dff3e2; --ok-fg: #17652e;
