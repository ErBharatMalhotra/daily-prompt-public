<meta property="og:type" content="article">
<meta property="og:site_name" content="The Daily Prompt">
<meta property="og:title" content="Google Severs Ties With Manufacturer After Botnet Discovery — The Daily Prompt">
<meta property="og:description" content="Google has dismantled a botnet embedded within 1.3 million Android devices by manufacturing partner Videostrong Technology Co. The Shenzhen-based firm">
<meta property="og:url" content="https://news.bharatdn.com/article/2026-11-02/google-severs-ties-with-manufacturer-after-botnet-discovery">
<meta property="og:image" content="https://news.bharatdn.com/og/2026-11-02/google-severs-ties-with-manufacturer-after-botnet-discovery.png">
<meta property="og:image:width" content="1200">
