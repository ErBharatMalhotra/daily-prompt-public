<style>/* theme.css — "Modern Editorial" skin for The Daily Prompt.
 * Design tokens first; dark is the default, light via [data-theme=light].
 * Heavy effects are limited to the sticky nav (small area) so the site stays fast.
 */

/* ---------- tokens ---------- */
:root {
  --ink: #ece7dd;
  --ink-soft: #b8b2a6;
  --paper: #121214;
  --paper-2: #1a1a1e;
  --card: #1f1f24;
  --line: #2c2c33;
  --accent: #e85a5a; /* >=4.5:1 on --paper (was #e03e3e = 4.39:1, WCAG AA fail) */
  --accent-deep: #8b0000;
  --ok-bg: #10331c; --ok-fg: #7ede9b;
  --bad-bg: #3a1416; --bad-fg: #f2a0a0;
  --conf-bg: #14243a; --conf-fg: #9cc4f0;
  --serif: "Source Serif 4", "Source Serif 4 Fallback", Georgia, "Times New Roman", serif;
  --sans: "Inter", "Inter Fallback", system-ui, -apple-system, "Segoe UI", sans-serif;
  --radius: 14px;
  --shadow: 0 10px 30px rgba(0, 0, 0, .35);
  --shadow-soft: 0 4px 14px rgba(0, 0, 0, .25);
  --nav-bg: rgba(18, 18, 20, .62);
}
[data-theme="light"] {
  --ink: #191919;
  --ink-soft: #5c5952;
  --paper: #f7f3ea;
  --paper-2: #efe9db;
  --card: #ffffff;
  --line: #e3dcc9;
  --accent: #a31212;
  --accent-deep: #8b0000;
  --ok-bg: #dff3e2; --ok-fg: #17652e;
  --bad-bg: #f9e0e0; --bad-fg: #8f1f1f;
  --conf-bg: #e2ecfa; --conf-fg: #1d4e86;
  --shadow: 0 10px 26px rgba(60, 50, 30, .12);
  --shadow-soft: 0 4px 12px rgba(60, 50, 30, .10);
  --nav-bg: rgba(247, 243, 234, .68);
}

/* Metric-compatible fallbacks: the web-font swap must not move layout (CLS).
 * size-adjust/ascent-override tune the local font to the webfont's metrics. */
@font-face {
  font-family: "Inter Fallback";
  src: local("Arial"), local("Helvetica Neue"), local("Segoe UI");
  size-adjust: 107%;
  ascent-override: 90%;
  descent-override: 22%;
  line-gap-override: 0%;
}
@font-face {
  font-family: "Source Serif 4 Fallback";
  src: local("Georgia"), local("Times New Roman");
  size-adjust: 100%;
  ascent-override: 92%;
  descent-override: 24%;
  line-gap-override: 0%;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--sans);
  background: var(--paper);
  color: var(--ink);
  margin: 0;
  line-height: 1.6;
  transition: background .3s ease, color .3s ease;
}
a { color: var(--accent); }
img { max-width: 100%; }

.wrap { max-width: 980px; margin: 0 auto; padding: 20px 18px 72px; }

/* ---------- glass header (only heavy effect on the page) ---------- */
.topbar {
  position: sticky;
  top: 0;
  z-index: 9990;
  background: var(--nav-bg);
  -webkit-backdrop-filter: blur(14px) saturate(160%);
  backdrop-filter: blur(14px) saturate(160%);
  border-bottom: 1px solid var(--line);
}
.topbar-row {
  max-width: 980px; margin: 0 auto; padding: 10px 18px;
  display: flex; align-items: center; gap: 14px;
}
.topbar .brand {
  font-family: var(--serif);
  font-weight: 700; font-size: 19px; letter-spacing: .5px;
  color: var(--ink); text-decoration: none; white-space: nowrap;
}
.topbar .brand span { color: var(--accent); }
.topbar .tools { margin-left: auto; display: flex; align-items: center; gap: 8px; }
.topbar .tools a, .topbar .tools button {
  color: var(--ink-soft); text-decoration: none; font-size: 13px;
  background: transparent; border: 1px solid transparent; border-radius: 999px;
  padding: 6px 10px; cursor: pointer; font-family: var(--sans);
}
.topbar .tools a:hover, .topbar .tools button:hover { color: var(--ink); background: rgba(128,128,128,.14); }
.catrow {
  max-width: 980px; margin: 0 auto; padding: 0 18px 9px;
  display: flex; gap: 6px; flex-wrap: wrap; overflow-x: auto; scrollbar-width: none;
}
.catrow::-webkit-scrollbar { display: none; }
.catgrp {
  display: inline-flex; align-items: center; gap: 5px;
  padding-right: 10px; margin-right: 4px; border-right: 1px solid var(--line);
}
.catgrp:last-child { border-right: 0; margin-right: 0; }
.catgrp b {
  color: var(--ink-soft); font-size: 12px; letter-spacing: 1.5px;
  text-transform: uppercase; opacity: .85; margin-right: 2px; white-space: nowrap;
}
.catrow a {
  flex: 0 0 auto; color: var(--ink-soft); text-decoration: none;
  text-transform: uppercase; letter-spacing: .8px; font-size: 12px; font-weight: 600;
  padding: 5px 12px; border: 1px solid var(--line); border-radius: 999px;
  background: transparent;
}
.catrow a:hover { color: var(--ink); border-color: var(--accent); }
.catrow a.on { color: #fff; background: var(--accent); border-color: var(--accent); }

/* ---------- header block ---------- */
header.mast { text-align: center; padding: 30px 0 8px; }
header.mast h1 {
  font-family: var(--serif); font-size: clamp(30px, 5.4vw, 46px);
  margin: 0; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 700;
}
header.mast h1 a { color: inherit; text-decoration: none; }
header.mast h1 a:hover { color: var(--accent); }
header.mast p { margin: 6px 0 0; font-style: italic; color: var(--ink-soft); font-size: 15px; }
.masthead-stats {
  display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
  font-size: 12px; color: var(--ink-soft); margin-top: 10px;
  text-transform: uppercase; letter-spacing: 1px;
}
.nav { text-align: center; font-size: 14px; margin: 12px 0 0; color: var(--ink-soft); }

/* ---------- section headers ---------- */
h2.sec {
  font-family: var(--serif); font-size: 21px; letter-spacing: 1.5px; text-transform: uppercase;
  border-bottom: 2px solid var(--accent); padding-bottom: 6px; margin: 34px 0 14px;
}

/* ---------- stories / cards ---------- */
.story { border-bottom: 1px solid var(--line); padding: 20px 0; }
.story.single { border-bottom: none; }
.story h2 { font-family: var(--serif); margin: 4px 0 10px; font-size: 25px; line-height: 1.25; }
.story h2 a { color: inherit; text-decoration: none; }
.story h2 a:hover { color: var(--accent); }
.story h1 { font-family: var(--serif); margin: 6px 0 14px; font-size: clamp(26px, 4.6vw, 36px); line-height: 1.2; }

.story.hero {
  background: var(--card);
  border: 1px solid var(--line);
  border-top: 4px solid var(--accent);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 26px 26px 20px;
  margin: 20px 0;
  transition: transform .18s ease, box-shadow .18s ease;
}
.story.hero:hover { transform: translateY(-2px); box-shadow: 0 16px 38px rgba(0,0,0,.42); }
.story.hero h2 { font-size: clamp(27px, 4.8vw, 36px); margin: 8px 0; }
.lede { font-size: 17px; font-style: italic; color: var(--ink-soft); }

.meta {
  font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase;
  color: var(--ink-soft); display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
}
.meta .beat-tag { color: #fff; font-weight: 700; }
.tags { margin: 0 0 12px; font-size: 13px; color: var(--accent); }
.critique { font-style: italic; color: var(--ink-soft); border-left: 3px solid var(--accent); padding-left: 10px; }
.hi-title a { font-size: 16px; }
.src { font-size: 13px; color: var(--ink-soft); }

/* Provenance box: every outlet the story was synthesised from (multi-source). */
.provenance { border: 1px solid var(--line, rgba(148,163,184,.25)); border-left: 3px solid var(--accent); border-radius: 8px; padding: 12px 14px; margin: 18px 0; font-size: 13.5px; background: var(--panel, rgba(148,163,184,.06)); }
.provenance b { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: .8px; color: var(--ink-soft); margin-bottom: 6px; }
.cityguide { border: 1px solid var(--line, rgba(148,163,184,.25)); border-left: 3px solid var(--accent); border-radius: 8px; padding: 12px 14px; margin: 18px 0; font-size: 13.5px; background: var(--panel, rgba(148,163,184,.06)); }
.cityguide b { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: .8px; color: var(--ink-soft); margin-bottom: 6px; }
.cityguide p { margin: 0; }
.cityguide a { color: var(--accent); }
.provenance ul { list-style: none; margin: 0 0 8px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; }
.provenance li::before { content: "\25B8"; color: var(--accent); margin-right: 5px; }
.provenance a { color: var(--link, var(--accent)); text-decoration: none; border-bottom: 1px solid transparent; }
.provenance a:hover { border-bottom-color: currentColor; }
.provenance p { margin: 0; color: var(--ink-soft); font-size: 12.5px; }

/* ---------- badges (pills) ---------- */
.badge { padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: .6px; }
.badge.ok { background: var(--ok-bg); color: var(--ok-fg); }
.badge.bad { background: var(--bad-bg); color: var(--bad-fg); }
.badge.quick { background: rgba(224,62,62,.14); color: var(--accent); border: 1px solid rgba(224,62,62,.4); text-transform: uppercase; }
.badge.conf { background: var(--conf-bg); color: var(--conf-fg); }

/* ---------- beat color strips on hero via data attr (optional future) ---------- */

/* ---------- misc blocks ---------- */
.stale { background: #3a2e10; border: 1px solid #a9852c; color: #f2d489; padding: 12px 16px; margin: 16px 0; font-size: 14px; border-radius: var(--radius); }
[data-theme="light"] .stale { background: #fdf0d5; border-color: #e0b95a; color: #6b5210; }
.st-ok { color: #7fc97f; }
.st-warn { color: #e0b95a; }
.st-stale { color: #e03e3e; }
[data-theme="light"] .st-ok { color: #256b25; }
[data-theme="light"] .st-warn { color: #8a6d1a; }
[data-theme="light"] .st-stale { color: #b02020; }
.dates { display: flex; justify-content: space-between; font-size: 14px; margin: 16px 0; }
.crumb { font-size: 14px; color: var(--ink-soft); }
table { width: 100%; border-collapse: collapse; margin: 16px 0; }
td, th { border: 1px solid var(--line); padding: 7px 11px; text-align: left; font-size: 14px; }
th { font-weight: 600; color: var(--ink-soft); text-transform: uppercase; font-size: 12px; letter-spacing: 1px; }
footer { margin-top: 40px; font-size: 12.5px; color: var(--ink-soft); text-align: center; border-top: 1px solid var(--line); padding-top: 18px; }

/* ---------- columns / briefs ---------- */
.cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0 24px; }
.col { border-right: 1px solid var(--line); padding-right: 18px; }
.col:last-child { border-right: none; }
.col h3 { font-family: var(--serif); font-size: 15px; text-transform: uppercase; letter-spacing: 1px; margin: 12px 0 8px; }
.col h3 a { color: var(--ink); text-decoration: none; }
.col h3 a:hover { color: var(--accent); }
.col ul { list-style: none; margin: 0; padding: 0; }
.col li { margin: 0 0 12px; font-size: 14px; line-height: 1.45; }
.col li a { color: var(--ink); text-decoration: none; }
.col li a:hover { color: var(--accent); }
.col small, ul.brief li small { color: var(--ink-soft); font-size: 12px; }
ul.brief { list-style: none; padding: 0; margin: 0; }
ul.brief li { padding: 8px 0; border-bottom: 1px dotted var(--line); font-size: 15px; }

/* ---------- tiles / pipeline ---------- */
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 14px 0; }
.tile {
  background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
  padding: 14px 12px; text-align: center; font-size: 13px; text-decoration: none; color: var(--ink);
  transition: transform .15s ease, border-color .15s ease;
}
.tile b { display: block; font-size: 16px; margin-bottom: 2px; font-family: var(--serif); }
.tile:hover { border-color: var(--accent); transform: translateY(-2px); }

.pipeline { display: flex; gap: 10px; align-items: stretch; margin: 14px 0; flex-wrap: wrap; }
.pstep {
  flex: 1 1 160px; background: var(--card); border: 1px solid var(--line);
  border-radius: var(--radius); padding: 14px; text-align: center; min-width: 150px;
}
.pstep .num { display: block; font-size: 12px; letter-spacing: 2px; color: var(--accent); font-weight: 700; }
.pstep .ico { display: block; font-size: 24px; margin: 6px 0; }
.pstep b { display: block; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
.pstep p { font-size: 12.5px; color: var(--ink-soft); margin: 0; line-height: 1.45; }
.parrow { align-self: center; font-size: 20px; color: var(--accent); flex: 0 0 auto; }
@media (max-width: 700px) { .parrow { display: none; } }
.about-note { font-size: 13.5px; color: var(--ink-soft); border-left: 3px solid var(--accent); padding-left: 12px; font-style: italic; }

/* ---------- translate gadget ---------- */
.gtr {
  display: flex; justify-content: center; align-items: center; gap: 8px;
  padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 13px; color: var(--ink-soft);
  min-height: 47px; /* reserve space for the late-injected Google Translate widget (CLS) */
}
.gtr .goog-te-gadget { font-size: 13px !important; }
#google_translate_element * { color: var(--ink) !important; } /* gadget injects black text on our dark bar */
.gtr .goog-te-gadget-simple {
  border: 1px solid var(--line) !important; border-radius: 8px; padding: 4px 10px !important;
  background: var(--card) !important; color: var(--ink) !important;
}
.goog-te-banner-frame { display: none !important; }
.goog-te-gadget-icon { display: none !important; } /* Google's 19px cleardot.gif = low-res image audit fail */
body { top: 0 !important; }

/* ---------- share / saved / search ---------- */
.sharebar { margin: 14px 0 4px; font-size: 14px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 11px 14px; }
.sharebar a { text-decoration: none; }
.sharebar a:hover { color: var(--accent); }
.savedlist li { padding: 7px 0; border-bottom: 1px dotted var(--line); font-size: 15px; }
#q { width: 100%; padding: 12px 14px; font-size: 16px; font-family: var(--sans); background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius); }
.hit { border-bottom: 1px solid var(--line); padding: 10px 0; }
.hit small { color: var(--ink-soft); }

/* ---------- per-beat colour system ([data-beat] vars are generated) ---------- */
[data-beat] { --beat: var(--accent); }
.beat-tag {
  display: inline-block; background: var(--beat, var(--accent)); color: #fff;
  padding: 1px 8px; border-radius: 6px; font-weight: 700; letter-spacing: .5px;
  font-size: 12px; /* explicit: it sits inside .meta, which is sub-12px */
}
.story[data-beat]:not(.single):not(.hero) { border-left: 3px solid var(--beat, transparent); padding-left: 14px; }
.story.hero[data-beat] { border-top-color: var(--beat, var(--accent)); }
.col[data-beat] h3 { border-bottom: 2px solid var(--beat, var(--line)); padding-bottom: 4px; }
header[data-beat] h1 { display: inline-block; border-bottom: 4px solid var(--beat, var(--accent)); padding-bottom: 6px; }

/* ---------- editorial typography ---------- */
.story.single > p:first-of-type::first-letter {
  float: left; font-family: var(--serif); font-weight: 700;
  font-size: 3.05em; line-height: .82; padding: 5px 10px 0 0; color: var(--accent);
}
.critique::before { content: "\201C"; font-family: var(--serif); font-size: 1.5em; line-height: 0; color: var(--accent); margin-right: 3px; }
.meta, .masthead-stats, .dates, table, .src { font-variant-numeric: tabular-nums; }

/* ---------- article hero art (Pillow-generated) ---------- */
.hero-art {
  display: block; width: 100%; height: auto; border-radius: var(--radius);
  border: 1px solid var(--line); margin: 6px 0 18px;
}

/* ---------- data-viz + front-page glance ---------- */
.identicon { border-radius: 5px; vertical-align: -6px; margin-right: 8px; }
.spark { display: block; }
.glance { display: flex; gap: 20px; align-items: center; justify-content: center; flex-wrap: wrap; margin: 14px 0 6px; }
.glance .g-item { text-align: center; }
.glance .g-item b { display: block; font-family: var(--serif); font-size: 22px; line-height: 1.1; }
.glance .g-item span { font-size: 12px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--ink-soft); }
.glance .g-spark { opacity: .9; }
@media (max-width: 560px) { .glance .g-spark { display: none; } }

/* ---------- inline icons ---------- */
.ic { vertical-align: -2px; margin-right: 5px; }
.sharebar a { display: inline-flex; align-items: center; }

/* ---------- reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
  html { scroll-behavior: auto; }
}
[data-beat="national"]{--beat:#8b0000;}[data-beat="world"]{--beat:#143c6e;}[data-beat="defence"]{--beat:#2d3c46;}[data-beat="business"]{--beat:#145a3c;}[data-beat="finance"]{--beat:#146e2d;}[data-beat="education"]{--beat:#784614;}[data-beat="sports"]{--beat:#005a5a;}[data-beat="cricket"]{--beat:#006e3c;}[data-beat="entertainment"]{--beat:#963c14;}[data-beat="positive"]{--beat:#8c6400;}[data-beat="funny"]{--beat:#a05064;}[data-beat="science"]{--beat:#645000;}[data-beat="environment"]{--beat:#286928;}[data-beat="space"]{--beat:#1e2d5f;}[data-beat="health"]{--beat:#6e1446;}[data-beat="tech"]{--beat:#46286e;}[data-beat="ai"]{--beat:#552d87;}</style></head><body><div class="topbar"><div class="topbar-row">
