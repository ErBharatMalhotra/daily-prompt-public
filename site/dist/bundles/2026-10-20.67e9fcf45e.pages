  src: local("Georgia"), local("Times New Roman");
  size-adjust: 100%;
  ascent-override: 92%;
  descent-override: 24%;
  line-gap-override: 0%;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--sans);
  background: var(--paper);
  color: var(--ink);
  margin: 0;
  line-height: 1.6;
  transition: background .3s ease, color .3s ease;
}
a { color: var(--accent); }
