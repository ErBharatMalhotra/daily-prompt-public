# Cloudflare Pages custom headers for news.bharatdn.com
# Added in the 2026-10-02 network audit: this portal shipped with no HSTS and no
# X-Frame-Options. Mirrors the root domain's _headers.
#
# Strict-Transport-Security: max-age 1 saal, bina includeSubDomains
#   (includeSubDomains tabhi add karna jab har subdomain HTTPS-ready ho)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# Daily Edition bundles (2026-10-05): raw bundle files are plumbing — the
# worker serves their contents at the normal article/media URLs, so the files
# themselves must never be indexed. 60s cache keeps a fresh manifest visible.
/bundles/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=60